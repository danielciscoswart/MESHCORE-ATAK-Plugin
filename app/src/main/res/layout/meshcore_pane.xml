<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Action buttons stay at the top so landscape ATAK panes always show them. -->
    <Button
        android:id="@+id/meshcore_connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/connect" />

    <Button
        android:id="@+id/meshcore_disconnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/disconnect" />

    <Button
        android:id="@+id/meshcore_opt_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/opt_in" />

    <EditText
        android:id="@+id/meshcore_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/room_hint"
        android:inputType="text"
        android:maxLength="32"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/meshcore_out_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/chat_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="200"
        android:textSize="12sp" />

    <Button
        android:id="@+id/meshcore_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/send_chat" />

    <CheckBox
        android:id="@+id/meshcore_watch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="false"
        android:text="@string/watch_geochat"
        android:textSize="12sp" />

    <!-- Status scrolls inside the pane; long scan/caveat text must not push buttons off-screen. -->
    <ScrollView
        android:id="@+id/meshcore_status_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/meshcore_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="@string/status_idle"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:typeface="monospace" />
    </ScrollView>
</LinearLayout>
